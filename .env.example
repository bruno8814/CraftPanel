# ============================================================
# CraftPanel — Variables de Entorno de Configuración
# ============================================================
# Copia este archivo a ".env" y personaliza según tu entorno.
# En Proxmox VE / Debian / Linux o Windows.
# ============================================================

# ── Servidor Web y API ──────────────────────────────────────
# Puerto HTTP principal del panel (por defecto: 3000)
PORT=3000

# Entorno: "production" o "development"
NODE_ENV=production

# ── Almacenamiento y Rutas (Agnósticas al Sistema Operativo) ─
# Carpeta donde se alojan las instancias de servidores de Minecraft.
# En Proxmox puedes apuntar a un punto de montaje ZFS dedicado:
#   SERVERS_DIR=/mnt/zfs-pool/minecraft/servidores
# En Windows puedes usar una ruta relativa o absoluta:
#   SERVERS_DIR=./servidores
SERVERS_DIR=./servidores

# Carpeta donde se guardan los datos del panel (usuarios, PINs, alertas, horarios).
DATA_DIR=./data

# Carpeta donde se almacenan las copias de seguridad (.zip).
# Puede apuntar a un disco secundario, NFS o punto de montaje de backups:
#   BACKUPS_DIR=/mnt/backups/craftpanel
BACKUPS_DIR=./backups

# ── Seguridad y Autenticación ───────────────────────────────
# Clave secreta para firmar tokens JWT (si no se especifica, se genera una automática)
# JWT_SECRET=tu-clave-secreta-aleatoria-super-segura

# ── Respaldo de Mods (CurseForge API Opcional) ───────────────
# Si deseas que el panel consulte directamente el catálogo de CurseForge además de Modrinth,
# puedes obtener una API Key gratuita en https://console.curseforge.com/
# CURSEFORGE_API_KEY=$2a$10$...
