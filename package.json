{
  "name": "mc-panel",
  "version": "0.1.0",
  "description": "Panel de gestión de servidores de Minecraft autoalojado",
  "private": true,
  "scripts": {
    "dev": "tsx watch backend/src/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node backend/dist/index.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pidusage": "^4.0.1",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pidusage": "^2.0.5",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
