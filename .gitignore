# ============================================================
# .gitignore — CraftPanel
# ============================================================

# 1. Dependencias de Node.js
node_modules/
frontend/node_modules/

# 2. Compilados y artefactos de build
backend/dist/
frontend/dist/

# 3. Datos locales y servidores de Minecraft (¡NUNCA subir a Git!)
servidores/
backups/
data/
*.db
*.sqlite

# 4. Variables de entorno y secretos
.env
.env.local
.env.production
*.pem
*.key

# 5. Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Archivos del sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 7. Caché de Vite y TypeScript
.vite/
frontend/.vite/
*.tsbuildinfo

# 8. Proyecto Independiente Flea Market (Mod y Portal de Jugadores)
mod/
fleamarket/
.gradle/
*.class
*.jar
